tellraw @s ["",{"text":"=========== True-Economy Help ===========","color":"aqua","bold":true}]
tellraw @s ["  ",{"text":"How it works","color":"gold","bold":true}]
tellraw @s ["  The market has 8 commodities. Each cycle supply and demand drift,"]
tellraw @s ["  and prices move with the imbalance: price = base + base*(demand-supply)/20."]
tellraw @s ["  Buying raises demand and pushes future prices up; selling (next release) lowers it."]
tellraw @s ["  The economy runs every ~10 in-game seconds (200 ticks)."]
tellraw @s ["  ",{"text":"Banks","color":"blue","bold":true}]
tellraw @s ["  Deposited crowns earn interest (0.2% per cycle, capped)."]
tellraw @s ["  ",{"text":"Black Market","color":"dark_purple","bold":true}]
tellraw @s ["  Stand near emerald/diamond/gold/netherite blocks to discover them,"]
tellraw @s ["  then buy special blocks at 2x the commodity price."]
tellraw @s ["  ",{"text":"Custom pay","color":"yellow","bold":true}]
tellraw @s ["  ",{"text":"/function trueeconomy:cmd/pay {to:\"NAME\",amt:100}","color":"gray"}]